# Curated, portable GNOME settings captured from Fedora 44 / GNOME 50.
# Deliberately excludes locations, recent paths, timestamps, window state and command history.

[org/gnome/desktop/interface]
accent-color='blue'
color-scheme='prefer-dark'
enable-animations=true
show-battery-percentage=true

[org/gnome/desktop/peripherals/touchpad]
two-finger-scrolling-enabled=true

[org/gnome/desktop/privacy]
report-technical-problems=false

[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'

[org/gnome/mutter]
overlay-key='Super'

[org/gnome/nautilus/preferences]
default-folder-viewer='list-view'

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=false
night-light-schedule-automatic=false

[org/gnome/shell]
favorite-apps=['brave-origin.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop', 'gns3.desktop']

[org/gnome/shell/extensions/blur-my-shell]
settings-version=2

[org/gnome/shell/extensions/blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
pipeline='pipeline_default'

[org/gnome/shell/extensions/blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
force-light-text=false
pipeline='pipeline_default'
sigma=30

[org/gnome/shell/extensions/dhruva]
click-effect='shrink'
clock-position='END'
dock-height=8
dock-margin=1
dock-position='BOTTOM'
full-width=false
gradient-direction='vertical'
grid-button-position='END'
hover-zoom-factor=1.4999999999999996
icon-alignment='CENTER'
icon-size=36
icon-spacing=6
independent-dock=false
indicator-style='line'
isolate-monitors=true
scroll-action-dock=true
show-clock=false
show-grid-button=true
show-notification-badges=true
use-old-grid-icon=true

[org/gnome/shell/extensions/ding]
check-x11wayland=true

[org/gnome/shell/extensions/just-perfection]
accent-color-icon=true
animation=5
clock-menu-position=0
clock-menu-position-offset=0
controls-manager-spacing-size=0
dash=true
dash-app-running=true
dash-icon-size=0
double-super-to-appgrid=true
panel=true
panel-in-overview=true
quick-settings=true
search=true
show-apps-button=true
startup-status=1
theme=false
top-panel-position=0
workspace=true
workspace-background-corner-size=0
workspace-peek=true
workspace-popup=true
workspace-switcher-should-show=false
workspace-wrap-around=false
workspaces-in-app-grid=true

[org/gnome/shell/extensions/space-bar/appearance]
application-styles='.space-bar {\n  -natural-hpadding: 12px;\n}\n\n.space-bar-workspace-label.active {\n  margin: 0 4px;\n  background-color: rgba(255,255,255,0.3);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive.empty {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,0.5);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}'

[org/gnome/shell/extensions/vitals]
hide-icons=false
icon-style=1
menu-centered=false
show-fan=false
show-gpu=false
use-higher-precision=false

[org/gnome/shell/keybindings]
show-screen-recording-ui=['<Shift><Super>s']
