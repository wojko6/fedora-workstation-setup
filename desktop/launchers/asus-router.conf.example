# Copy this file to desktop/launchers/asus-router.conf and fill in your local values.
# The real file is intended to stay local and must not be committed.
#
# This is a strict data file, not a shell script. Only the four keys below are
# accepted; shell commands, substitutions, duplicate keys, and unknown keys are
# rejected by scripts/render-asus-launcher.py.
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PORT="2222"
SSH_USER="router-admin"
ROUTER_HOST="192.168.1.1"
