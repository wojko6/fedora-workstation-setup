# GSConnect v73 Polish completion overlay.
# Completes all untranslated entries found in the exact upstream v73 Polish catalog
# plus audited user-visible source strings missing from the upstream POT/catalog
# and reviewed corrections for the RunCommand editor UI.
msgid ""
msgstr ""
"Project-Id-Version: gsconnect v73 local completion\n"
"PO-Revision-Date: 2026-09-24 17:00+0200\n"
"Last-Translator: fedora-workstation-setup project\n"
"Language-Team: Polish\n"
"Language: pl_PL\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=4; plural=(n==1 ? 0 : (n%10>=2 && n%10<=4) && (n%100<12 || n%100>14) ? 1 : n!=1 && (n%10>=0 && n%10<=1) || (n%10>=5 && n%10<=9) || (n%100>=12 && n%100<=14) ? 2 : 3);\n"

msgid "Edit Command"
msgstr "Edytuj polecenie"

msgid "Save"
msgstr "Zapisz"

msgid "Command Line"
msgstr "Wiersz polecenia"

msgid "Choose an executable"
msgstr "Wybierz plik wykonywalny"

msgid "Edit"
msgstr "Edytuj"

msgid "Remove"
msgstr "Usuń"

msgid "Connectivity Report"
msgstr "Raport łączności"

msgid "Display connectivity status"
msgstr "Wyświetlanie stanu łączności"

msgid "Links"
msgstr "Odnośniki"

msgid "Automatically open received URLs"
msgstr "Automatycznie otwieraj otrzymane adresy URL"

msgid "Retry"
msgstr "Spróbuj ponownie"

msgid ""
"The <tt>openssl</tt> command-line tool does not appear to be installed.\n"
"Use your distro's package manager to install it.\n"
"For more information, visit <a href=\"https://github.com/gsconnect/gnome-"
"shell-extension-gsconnect/wiki/Error#openssl-not-found\">the GSConnect wiki</"
"a>."
msgstr ""
"Narzędzie wiersza poleceń <tt>openssl</tt> nie jest zainstalowane.\n"
"Zainstaluj je za pomocą menedżera pakietów swojej dystrybucji.\n"
"Więcej informacji znajdziesz w <a href=\"https://github.com/gsconnect/gnome-"
"shell-extension-gsconnect/wiki/Error#openssl-not-found\">wiki GSConnect</a>."

msgid "Add device by IP…"
msgstr "Dodaj urządzenie za pomocą adresu IP…"

msgid "Invalid Device Name"
msgstr "Nieprawidłowa nazwa urządzenia"

#, javascript-format
msgid "Device name must not contain any of %s and have a length of 1-32 characters"
msgstr ""
"Nazwa urządzenia nie może zawierać żadnego z następujących znaków: %s i musi "
"mieć długość od 1 do 32 znaków"

msgid "Settings Migrated"
msgstr "Ustawienia zostały przeniesione"

msgid ""
"GSConnect has updated to support changes to the KDE Connect protocol. Some "
"devices may need to be re-paired."
msgstr ""
"GSConnect został zaktualizowany, aby obsługiwać zmiany w protokole KDE "
"Connect. Niektóre urządzenia mogą wymagać ponownego sparowania."

msgid "Target Device Name"
msgstr "Nazwa urządzenia docelowego"

#, javascript-format
msgid "Failed to pair with %s"
msgstr "Nie udało się sparować z %s"

msgid "Device clocks are out of sync"
msgstr "Zegary urządzeń nie są zsynchronizowane"
