msgstr "Dodaj do filtra"

#: ui/playerFilterPage.js:296 ui/vinylAppsPage.js:277
msgid "No active players detected"
msgstr "Nie wykryto aktywnych odtwarzaczy"

#: ui/playerFilterPage.js:297 ui/vinylAppsPage.js:278
msgid "Open a music app and click Refresh"
msgstr "Otwórz aplikację muzyczną i kliknij „Odśwież”"

#: ui/playerFilterPage.js:354
#, javascript-format
msgid "“%s” is already in the filter list"
msgstr "„%s” znajduje się już na liście filtra"

#: ui/playerFilterPage.js:358
#, javascript-format
