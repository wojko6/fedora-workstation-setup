msgstr "Pole wyszukiwania w podglądzie"

msgid "Dash"
msgstr "Pasek ulubionych"

msgid "Dash holds favorite and opened applications icons"
msgstr "Pasek zawiera ikony ulubionych i otwartych aplikacji"

msgid "Dash Separator"
msgstr "Separator paska"

msgid "Dash separator line that separates pin apps from unpin apps"
msgstr "Linia oddzielająca przypięte aplikacje od nieprzypiętych"

msgid "Dash App Running Indicator"
msgstr "Wskaźnik uruchomionej aplikacji na pasku"

msgid "The dot indicator in dash that shows the app is running"
msgstr "Kropka na pasku informująca, że aplikacja jest uruchomiona"

msgid "Show Applications Button"
msgstr "Przycisk Pokaż aplikacje"

msgid "Button in dash that toggles applications list visibility"
msgstr "Przycisk na pasku przełączający widoczność listy aplikacji"

msgid "On Screen Display (OSD)"
msgstr "Menu ekranowe (OSD)"

msgid "Volume and brightness on screen display when the change happens"
msgstr "Ekranowe wskaźniki głośności i jasności pojawiające się po zmianie wartości"

msgid "Workspace Popup"
msgstr "Okno przełączania obszarów roboczych"

