#: dist/components/window_menu/overriddenWindowMenu.js:117
msgid "Move to best tile"
msgstr "Przenieś do najlepszego kafelka"

#: dist/prefs.js:133
msgid "Dynamically adapt to the window's actual border radius"
msgstr "Dynamicznie dopasowuj do rzeczywistego promienia obramowania okna"

#: dist/prefs.js:201
msgid "Sync layout when tiling with Snap Assistant"
msgstr "Synchronizuj układ podczas układania za pomocą Asystenta przyciągania"

#: dist/prefs.js:203
msgid ""
"Change the active layout to match the layout used when tiling a window with "
"Snap Assistant"
msgstr ""
"Zmieniaj aktywny układ tak, aby odpowiadał układowi użytemu podczas układania "
"okna za pomocą Asystenta przyciągania"

#: dist/prefs.js:281
msgid "Raise tiled windows together"
msgstr "Przenoś ułożone okna razem na pierwszy plan"

#: dist/prefs.js:283
msgid ""
"When one tiled window is raised, raise all tiled windows into the foreground "
"together"
msgstr ""
"Gdy jedno ułożone okno jest przenoszone na pierwszy plan, przenoś razem na "
"pierwszy plan wszystkie ułożone okna"

#: dist/prefs.js:376
msgid "Enable window suggestions for screen edge tiling"
msgstr "Włącz sugestie okien podczas układania przy krawędziach ekranu"

#: dist/prefs.js:378
msgid "Suggests windows to occupy empty tiles when tiling to screen edges"
msgstr "Sugeruje okna do zajęcia pustych kafelków podczas układania przy krawędziach ekranu"

#: dist/prefs.js:999
msgid "Choose how windows snap to screen edges"
msgstr "Wybierz sposób przyciągania okien do krawędzi ekranu"

#: dist/prefs.js:1014
msgid "Default"
msgstr "Domyślny"

#: dist/prefs.js:1015
msgid "Follow quarters or screen halves"
msgstr "Uwzględniaj ćwiartki lub połowy ekranu"

#: dist/prefs.js:1020
msgid "Adaptive"
msgstr "Adaptacyjny"

#: dist/prefs.js:1021
msgid "Follow corners of selected layout or screen halves"
msgstr "Uwzględniaj narożniki wybranego układu lub połowy ekranu"

#: dist/prefs.js:1026
msgid "Granular"
msgstr "Szczegółowy"

#: dist/prefs.js:1027
msgid "Follow currently selected layout"
msgstr "Uwzględniaj aktualnie wybrany układ"
