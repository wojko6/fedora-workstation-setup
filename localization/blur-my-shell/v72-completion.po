# Blur my Shell v72 Polish completion overlay.
# Completes the 46 runtime-confirmed English fallbacks on the audited EGO v72 build.
msgid ""
msgstr ""
"Project-Id-Version: blur-my-shell v72 Polish completion\n"
"PO-Revision-Date: 2026-09-21 10:05+0200\n"
"Last-Translator: fedora-workstation-setup project\n"
"Language-Team: Polish\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Prefer closer pixels"
msgstr "Preferuj bliższe piksele"

msgid "Blend mode"
msgstr "Tryb mieszania"

msgid "How the color is blended in."
msgstr "Sposób mieszania koloru."

msgid "Normal"
msgstr "Normalny"

msgid "Multiply"
msgstr "Mnożenie"

msgid "Screen"
msgstr "Ekran"

msgid "Overlay"
msgstr "Nakładka"

msgid "Darken"
msgstr "Przyciemnianie"

msgid "Lighten"
msgstr "Rozjaśnianie"

msgid "Plus darker"
msgstr "Dodawanie — ciemniej"

msgid "Plus lighter"
msgstr "Dodawanie — jaśniej"

msgid "Color dodge"
msgstr "Rozjaśnianie koloru"

msgid "Color burn"
msgstr "Przyciemnianie koloru"

msgid "Hard light"
msgstr "Twarde światło"

msgid "Soft light"
msgstr "Miękkie światło"

msgid "Difference"
msgstr "Różnica"

msgid "Exclusion"
msgstr "Wykluczenie"

msgid "Hue"
msgstr "Odcień"

msgid "Saturation"
msgstr "Nasycenie"

msgid "Luminosity"
msgstr "Luminancja"

msgid "An effect that affects the luminosity of the image."
msgstr "Efekt wpływający na luminancję obrazu."

msgid "Shift brightness"
msgstr "Przesunięcie jasności"

msgid "The brightness to add of remove to the image."
msgstr "Wartość jasności dodawana do obrazu lub odejmowana od niego."

msgid "Multiply brightness"
msgstr "Mnożnik jasności"

msgid "Contrast"
msgstr "Kontrast"

msgid "The contrast of the image in regard to the center of the contrast."
msgstr "Kontrast obrazu względem środka kontrastu."

msgid "Contrast center"
msgstr "Środek kontrastu"

msgid "The center of the contrast to use."
msgstr "Środek kontrastu, który ma być używany."

msgid "Boxcar"
msgstr "Filtr prostokątny"

msgid "Dirac"
msgstr "Impuls Diraca"

msgid "Apply a spatial derivative, or a laplacian."
msgstr "Zastosuj pochodną przestrzenną lub operator Laplace’a."

msgid "Operation"
msgstr "Operacja"

msgid "The mathematical operation to apply."
msgstr "Operacja matematyczna do zastosowania."

msgid "1-step derivative"
msgstr "Pochodna jednokrokowa"

msgid "2-step derivative"
msgstr "Pochodna dwukrokowa"

msgid "Laplacian"
msgstr "Laplasjan"

msgid "RGB to HSL (advanced effect)"
msgstr "RGB na HSL (efekt zaawansowany)"

msgid "Converts the image from RGBA colorspace to HSLA."
msgstr "Konwertuje obraz z przestrzeni kolorów RGBA do HSLA."

msgid "HSL to RGB (advanced effect)"
msgstr "HSL na RGB (efekt zaawansowany)"

msgid "Converts the image from HSLA colorspace to RGBA."
msgstr "Konwertuje obraz z przestrzeni kolorów HSLA do RGBA."

msgid "Corner radius"
msgstr "Promień zaokrąglenia"

msgid "Radius for the corner rounding effect."
msgstr "Promień efektu zaokrąglania rogów."

msgid "Enable corner rounding on maximized and fullscreen"
msgstr "Włącz zaokrąglanie rogów dla okien zmaksymalizowanych i pełnoekranowych"

msgid "Include advanced effects"
msgstr "Uwzględnij efekty zaawansowane"

msgid "Coverflow Alt-Tab extension blur"
msgstr "Rozmycie rozszerzenia Coverflow Alt-Tab"

msgid "Make the coverflow alt-tab extension blurred, if it is used."
msgstr "Rozmywaj rozszerzenie Coverflow Alt-Tab, jeśli jest używane."


msgid "Whether or not the pixels that are closer to the original pixel will have more weight."
msgstr "Określa, czy piksele położone bliżej oryginalnego piksela mają mieć większą wagę."

msgid "The brightness multiplicator of the image, so that 0 means no brightness and 2 means infinite brightness."
msgstr "Mnożnik jasności obrazu, gdzie 0 oznacza brak jasności, a 2 nieskończoną jasność."

msgid "The saturation of the image, so that 0 means no saturation and 2 means infinite saturation."
msgstr "Nasycenie obrazu, gdzie 0 oznacza brak nasycenia, a 2 nieskończone nasycenie."

msgid "The dynamic blur is slower and only compatible with a gaussian blur effect, but shows content behind windows."
msgstr "Rozmycie dynamiczne jest wolniejsze i działa tylko z efektem rozmycia Gaussa, ale pokazuje zawartość znajdującą się za oknami."

msgid "In order to use rounded corners, please install the GNOME Rounded Blur library."
msgstr "Aby używać zaokrąglonych rogów, zainstaluj bibliotekę GNOME Rounded Blur."

msgid "Corner rounding effect will keep being applied to maximized and fullscreen windows."
msgstr "Efekt zaokrąglania rogów będzie nadal stosowany do okien zmaksymalizowanych i pełnoekranowych."

msgid ""
"A list of windows to blur.\n"
"Use * to match any sequence of characters (e.g., Firefox* or *Code*), and ? for a single one."
msgstr ""
"Lista okien, które mają być rozmywane.\n"
"Użyj * dla dowolnego ciągu znaków (np. Firefox* lub *Code*), a ? dla pojedynczego znaku."

msgid ""
"A list of windows not to blur.\n"
"Use * to match any sequence of characters (e.g., Firefox* or *Code*), and ? for a single one."
msgstr ""
"Lista okien, które nie mają być rozmywane.\n"
"Użyj * dla dowolnego ciągu znaków (np. Firefox* lub *Code*), a ? dla pojedynczego znaku."

msgid "Default"
msgstr "Domyślny"

msgid "Default rounded"
msgstr "Domyślny zaokrąglony"

msgid "Create new pipeline"
msgstr "Utwórz nowy proces"

msgid "New pipeline"
msgstr "Nowy proces"

msgid "Pipeline id:"
msgstr "Identyfikator procesu:"

msgid "No effect"
msgstr "Brak efektów"

#, c-format
msgid "%d effect"
msgid_plural "%d effects"
msgstr[0] "%d efekt"
msgstr[1] "%d efekty"
msgstr[2] "%d efektów"
